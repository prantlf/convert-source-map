{
  "name": "@prantlf/convert-source-map",
  "version": "2.1.0",
  "description": "Converts a source-map from/to different formats and allows adding/changing properties.",
  "repository": {
    "type": "git",
    "url": "git://github.com/prantlf/convert-source-map.git"
  },
  "homepage": "https://github.com/prantlf/convert-source-map#readme",
  "bugs": {
    "url": "https://github.com/prantlf/convert-source-map/issues"
  },
  "author": {
    "name": "Ferdinand Prantl",
    "email": "prantlf@gmail.com",
    "url": "http://prantl.tk"
  },
  "contributors": [
    {
      "name": "Thorsten Lorenz",
      "email": "thlorenz@gmx.de",
      "url": "http://thlorenz.com"
    }
  ],
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/prantlf/convert-source-map/blob/master/LICENSE"
    }
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "browser": "lib/index.umd.js",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "engine": {
    "node": ">=16.9"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "preprepare": "tap plugin add @tapjs/synonyms",
    "build": "rollup -c",
    "lint": "npm run lint:js && npm run lint:ts",
    "lint:js": "biome lint lib/index.js",
    "lint:ts": "tsc --noEmit test/types.ts",
    "check": "npm run check:cjs && npm run check:mjs",
    "check:cjs": "tap test/*.js --color -- --no-coverage",
    "check:mjs": "node test/index.mjs",
    "test": "npm run lint && npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@prantlf/convert-source-map": "link:",
    "@tapjs/synonyms": "^4.0.4",
    "inline-source-map": "^0.6.3",
    "rollup": "^4.53.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-swc-minify": "^1.3.0",
    "tap": "^21.1.3",
    "typescript": "^5.9.3"
  },
  "tap": {
    "plugin": [
      "@tapjs/synonyms"
    ]
  },
  "keywords": [
    "convert",
    "sourcemap",
    "source",
    "map",
    "browser",
    "debug"
  ]
}
